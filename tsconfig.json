{
  // 확장 코드(src/). 브라우저에서 돌고 esbuild가 묶는다. tsc는 타입 검사만 한다.
  "compilerOptions": {
    // Chrome 150(결정 0009)이 ES2025를 모두 지원한다. TypeScript 6의 기본값은 해마다 바뀌므로 적어 둔다.
    "target": "es2025",
    "lib": ["es2025", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["chrome-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noEmit": true,

    // 같은 import를 Node(빌드 스크립트가 기능 정의를 읽음)와 esbuild가 함께 읽으므로,
    // Node가 타입을 지우기만 해서 실행할 수 있는 문법만 쓴다.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // strict에 더해 켜는 엄격한 검사(quality 054).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
